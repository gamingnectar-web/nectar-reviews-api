{
  "name": "nectar-reviews-api",
  "version": "2.0.4-full-legacy-admin-restore",
  "description": "Nectar modular Shopify reviews, loyalty, discounts, cart rewards and campaigns API.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node -c server.js && node scripts/check-structure.js && node scripts/check-liquid-structure.js && node scripts/check-syntax.js",
    "structure": "node scripts/check-structure.js",
    "liquid:check": "node scripts/check-liquid-structure.js",
    "syntax": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
