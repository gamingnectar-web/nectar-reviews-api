# Core
NODE_ENV=production
PORT=3000
APP_URL=https://nectar-reviews-api.onrender.com
CORE_DB_URI=mongodb+srv://user:password@cluster.mongodb.net/nectar_core

# Shopify OAuth
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,write_products,read_discounts,write_discounts,read_price_rules,write_price_rules,write_metaobject_definitions,write_metaobjects

# Security
EMAIL_CREDENTIAL_SECRET=replace_with_32_plus_random_chars
TOKEN_SIGNING_SECRET=replace_with_32_plus_random_chars
ADMIN_SHARED_SECRET=temporary_dev_admin_secret
ALLOW_UNAUTHENTICATED_ADMIN=false

# Module defaults for new shops. Keep this small for a clean first experience.
# Options: reviews,loyalty,discounts,cart-rewards,campaigns,help
DEFAULT_ENABLED_MODULES=reviews,help

# Optional display settings
NECTAR_BRAND_NAME=Nectar
