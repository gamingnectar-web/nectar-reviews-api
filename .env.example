# Core
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-render-app.onrender.com
MONGODB_URI=mongodb+srv://user:password@cluster/nectar_app

# Optional separate audit database. Recommended for traceability/retention separation.
# If omitted, the app writes audit events to MONGODB_URI using database name nectar_audit.
MONGODB_AUDIT_URI=
MONGODB_AUDIT_DB=nectar_audit

# Security
SESSION_SECRET=replace-with-a-long-random-value
EMAIL_CREDENTIAL_SECRET=replace-with-a-long-random-value
CUSTOMER_ID_SECRET=replace-with-a-different-long-random-value
AUDIT_HASH_SECRET=replace-with-a-different-long-random-value
ADMIN_AUTH_MODE=shared_secret
ADMIN_API_SECRET=replace-with-a-long-random-admin-token
CRON_SECRET=replace-with-a-long-random-cron-token
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_JSON_SIZE=2mb
ALLOW_INSECURE_CUSTOMER_LOOKUP=false

# Shopify OAuth / Admin API
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_SCOPES=read_products,read_orders,write_products,write_discounts
SHOPIFY_API_VERSION=2025-10

# Optional single-store fallback for development only
SHOPIFY_STORE_URL=your-shop.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxx

# Module defaults. Per-shop module records override these.
MODULE_REVIEWS=true
MODULE_MESSAGING=true
MODULE_DISCOUNTS=false
MODULE_LOYALTY=false
MODULE_HELP=true
MODULE_AUDIT=true

# Loyalty worker defaults
LOYALTY_DEFAULT_APPROVAL_DAYS=14
LOYALTY_PENDING_BATCH_SIZE=100
