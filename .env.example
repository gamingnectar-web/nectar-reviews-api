# Required
CORE_DB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/platform_core
APP_URL=https://nectar-reviews-api.onrender.com
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
EMAIL_CREDENTIAL_SECRET=replace_with_32_plus_random_chars

# Recommended for local/dev admin access while App Bridge session token setup is being tested
ADMIN_SHARED_SECRET=replace_with_32_plus_random_chars
ALLOW_UNAUTHENTICATED_ADMIN=false

# Optional single-store development fallback only
SHOPIFY_STORE_URL=your-dev-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_or_custom_app_access_token

# Optional security/cors
ALLOWED_ADMIN_ORIGINS=https://admin.shopify.com,https://nectar-reviews-api.onrender.com
PORT=3000

# Optional but recommended when Loyalty becomes a separate paid module/database
# If omitted, loyalty falls back to CORE_DB_URI/MONGODB_URI so development still works.
LOYALTY_DB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/platform_loyalty

# Optional: enables Messaging > Modules AI generator. If omitted, safe local fallback still works.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODULE_MODEL=gpt-4.1-mini
