{% comment %}
  Nectar Cart Rewards Widget

  Add this block to cart drawer/cart page templates. The app design settings still come
  from the Cart Rewards admin; these block settings are useful fallbacks and theme-specific
  placement controls.
{% endcomment %}

<div
  id="NectarCartRewards-{{ block.id }}"
  class="nectar-cart-rewards"
  data-shop="{{ shop.permanent_domain }}"
  data-app-url="{{ block.settings.app_url }}"
  data-placement="{{ block.settings.placement }}"
  data-layout="{{ block.settings.layout }}"
  data-density="{{ block.settings.density }}"
  data-drawer-behaviour="{{ block.settings.drawer_behaviour }}"
>
  <div class="nectar-cart-rewards__loading">
    {{ block.settings.loading_text }}
  </div>
</div>

{{ 'nectar-cart-rewards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nectar-cart-rewards.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Nectar Cart Rewards",
  "target": "section",
  "settings": [
    {
      "type": "url",
      "id": "app_url",
      "label": "App URL",
      "info": "Your Nectar app URL, e.g. https://nectar-reviews-api.onrender.com"
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Placement",
      "default": "cart_drawer",
      "options": [
        { "value": "cart_drawer", "label": "Cart drawer" },
        { "value": "cart_page", "label": "Cart page" },
        { "value": "mini_progress", "label": "Mini progress" }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Fallback layout",
      "default": "premium_cards",
      "options": [
        { "value": "premium_cards", "label": "Premium cards" },
        { "value": "compact", "label": "Compact" },
        { "value": "drawer", "label": "Drawer first" },
        { "value": "timeline", "label": "Timeline" }
      ]
    },
    {
      "type": "select",
      "id": "density",
      "label": "Fallback spacing",
      "default": "comfortable",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "comfortable", "label": "Comfortable" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "drawer_behaviour",
      "label": "Drawer behaviour",
      "default": "embedded",
      "options": [
        { "value": "embedded", "label": "Embedded block" },
        { "value": "sticky", "label": "Sticky in drawer" },
        { "value": "collapsible", "label": "Scrollable panel" }
      ]
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Checking your rewards..."
    }
  ]
}
{% endschema %}
