{% comment %}
Nectar bulk/signed review page block. Used on a review landing page linked from post-purchase email.
{% endcomment %}
{{ 'nectar-review-page.css' | asset_url | stylesheet_tag }}
<form
  class="nectar-review-form"
  data-nectar-review-form
  data-shop-domain="{{ shop.permanent_domain }}"
  data-app-url="{{ block.settings.app_url }}"
>
  <input type="hidden" name="token" value="{{ request.params.token }}">
  <input type="hidden" name="itemId" value="{{ request.params.itemId | default: product.id }}">

  <label>Rating
    <select name="rating" required>
      <option value="5">5 stars</option>
      <option value="4">4 stars</option>
      <option value="3">3 stars</option>
      <option value="2">2 stars</option>
      <option value="1">1 star</option>
    </select>
  </label>

  <label>Title
    <input name="title" maxlength="180" placeholder="Great product">
  </label>

  <label>Review
    <textarea name="body" required minlength="2" maxlength="5000" placeholder="Tell us what you thought"></textarea>
  </label>

  <label>Name
    <input name="authorName" maxlength="120" placeholder="Customer">
  </label>

  <button type="submit">Submit review</button>
  <p data-nectar-review-message></p>
</form>
<script src="{{ 'nectar-review-page.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Nectar review form",
  "target": "section",
  "settings": [
    { "type": "url", "id": "app_url", "label": "Nectar app URL", "default": "https://nectar-reviews-api.onrender.com" }
  ]
}
{% endschema %}
