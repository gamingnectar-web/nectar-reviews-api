{% comment %}
Nectar star renderer snippet.
Accepts:
  rating: number
  count: number
  show_count: boolean
{% endcomment %}
{%- assign nectar_rating = rating | default: 0 | plus: 0 -%}
{%- assign nectar_count = count | default: 0 | plus: 0 -%}
<span class="nectar-stars" aria-label="{{ nectar_rating }} out of 5 stars">
  {%- for i in (1..5) -%}
    {%- assign nectar_previous_star = i | minus: 1 -%}
    {%- if nectar_rating >= i -%}
      <span class="nectar-star nectar-star--filled">★</span>
    {%- elsif nectar_rating > nectar_previous_star -%}
      <span class="nectar-star nectar-star--half">★</span>
    {%- else -%}
      <span class="nectar-star nectar-star--empty">☆</span>
    {%- endif -%}
  {%- endfor -%}
</span>
{%- if show_count -%}
  <span class="nectar-review-count">{{ nectar_count }} review{%- unless nectar_count == 1 -%}s{%- endunless -%}</span>
{%- endif -%}
