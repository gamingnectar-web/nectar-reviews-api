<section class="nectar-seo-reviews-page nectar-seo-reviews-page--search" data-api-url="{{ block.settings.app_url | escape }}/api" data-shop-domain="{{ shop.permanent_domain }}" data-title="{{ block.settings.title | escape }}" data-intro="{{ block.settings.intro | escape }}" data-limit="{{ block.settings.limit }}">
  <div class="nectar-seo-bg" aria-hidden="true">
    <span class="nectar-seo-bg__box nectar-seo-bg__box--one"></span>
    <span class="nectar-seo-bg__box nectar-seo-bg__box--two"></span>
    <span class="nectar-seo-bg__box nectar-seo-bg__box--three"></span>
    <span class="nectar-seo-bg__box nectar-seo-bg__box--four"></span>
    <span class="nectar-seo-bg__box nectar-seo-bg__box--five"></span>
  </div>
  <div class="nectar-seo-reviews__inner">
    <header class="nectar-seo-reviews__header">
      <p class="nectar-seo-reviews__eyebrow">Customer review search</p>
      <h1>{{ block.settings.title }}</h1>
      <p>{{ block.settings.intro }}</p>
    </header>

    <form class="nectar-seo-search" data-nectar-seo-filters role="search">
      <label class="visually-hidden" for="nectar-seo-review-search-{{ block.id }}">Search product reviews</label>
      <input id="nectar-seo-review-search-{{ block.id }}" type="search" name="q" placeholder="{{ block.settings.placeholder | escape }}" autocomplete="off">
      <select name="minRating" aria-label="Minimum rating"><option value="0">All ratings</option><option value="5">5 stars</option><option value="4">4 stars & up</option><option value="3">3 stars & up</option></select>
      <button type="submit">Search</button>
    </form>

    <div data-nectar-seo-summary class="nectar-seo-reviews__summary">Loading reviews…</div>
    <div data-nectar-seo-tags class="nectar-seo-reviews__chips"></div>

    <section class="nectar-seo-recommendations" data-nectar-seo-recommendations aria-live="polite"></section>
    <div data-nectar-seo-list class="nectar-seo-reviews__list"></div>
  </div>
</section>

{{ 'nectar-all-reviews-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nectar-all-reviews-page.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "All Reviews SEO Page",
  "target": "section",
  "settings": [
    { "type": "text", "id": "app_url", "label": "Nectar app URL" },
    { "type": "text", "id": "title", "label": "Page title", "default": "Find your next favourite product" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Search real customer reviews by product, flavour profile, rating, ingredients, feeling or feedback. Recommendations are powered by approved review data." },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "Search G FUEL flavours, sour, sweet, tropical, mango, caffeine..." },
    { "type": "range", "id": "limit", "min": 20, "max": 200, "step": 10, "label": "Maximum reviews", "default": 120 }
  ]
}
{% endschema %}
