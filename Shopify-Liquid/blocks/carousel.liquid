<div
  id="nr-carousel-{{ block.id }}"
  class="nr-carousel"
  style="
    --nr-max-width: {% if block.settings.width_mode == 'full' %}100%{% else %}{{ block.settings.max_width }}px{% endif %};
    --nr-section-padding-x: {{ block.settings.section_padding_x }}px;
    --nr-section-padding-y: {{ block.settings.section_padding_y }}px;
    --nr-card-width: {{ block.settings.card_width }}px;
    --nr-card-min-height: {{ block.settings.card_min_height }}px;
    --nr-card-radius: {{ block.settings.card_radius }}px;
    --nr-card-bg: {{ block.settings.card_bg }};
    --nr-card-border: {{ block.settings.card_border }};
    --nr-text: {{ block.settings.text_color }};
    --nr-muted: {{ block.settings.muted_color }};
    --nr-heading: {{ block.settings.heading_color }};
    --nr-star: {{ block.settings.star_color }};
    --nr-arrow-bg: {{ block.settings.arrow_bg }};
    --nr-arrow-color: {{ block.settings.arrow_color }};
    --nr-arrow-border: {{ block.settings.arrow_border }};
    --nr-arrow-opacity: {{ block.settings.arrow_opacity | divided_by: 100.0 }};
    --nr-arrow-size: {{ block.settings.arrow_size }}px;
    --nr-arrow-radius: {% if block.settings.arrow_shape == 'circle' %}999px{% elsif block.settings.arrow_shape == 'rounded' %}12px{% else %}0px{% endif %};
    --nr-product-btn-bg: {{ block.settings.product_button_bg }};
    --nr-product-btn-color: {{ block.settings.product_button_color }};
    --nr-product-btn-radius: {{ block.settings.product_button_radius }}px;
  "
  data-arrow-layout="{{ block.settings.arrow_layout }}"
  data-arrow-icon="{{ block.settings.arrow_icon }}"
  data-card-shadow="{{ block.settings.card_shadow }}"
  data-width-mode="{{ block.settings.width_mode }}"
>
  <div class="nr-carousel-inner">
    {% if block.settings.title != blank %}
      <div class="nr-carousel-heading-wrap">
        <h2 class="nr-carousel-heading">{{ block.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="nr-carousel-top-controls" aria-hidden="true">
      <button class="nr-car-nav nr-car-prev" type="button" data-dir="prev" aria-label="Previous reviews"></button>
      <button class="nr-car-nav nr-car-next" type="button" data-dir="next" aria-label="Next reviews"></button>
    </div>

    <div class="nr-carousel-track-shell">
      <button class="nr-car-nav nr-car-prev nr-car-nav-split" type="button" data-dir="prev" aria-label="Previous reviews"></button>

      <div class="nr-car-track" id="nr-carousel-track-{{ block.id }}" aria-live="polite"></div>

      <button class="nr-car-nav nr-car-next nr-car-nav-split" type="button" data-dir="next" aria-label="Next reviews"></button>
    </div>
  </div>
</div>

<style>
  #nr-carousel-{{ block.id }} {
    width: 100%;
    display: none;
    box-sizing: border-box;
    padding: var(--nr-section-padding-y) var(--nr-section-padding-x);
    font-family: Poppins, Arial, Helvetica, sans-serif;
  }

  #nr-carousel-{{ block.id }} .nr-carousel-inner {
    width: 100%;
    max-width: var(--nr-max-width);
    margin: 0 auto;
    position: relative;
    box-sizing: border-box;
  }

  #nr-carousel-{{ block.id }}[data-width-mode="full"] .nr-carousel-inner {
    max-width: 100%;
  }

  #nr-carousel-{{ block.id }} .nr-carousel-heading-wrap {
    text-align: center;
    margin-bottom: 28px;
  }

  #nr-carousel-{{ block.id }} .nr-carousel-heading {
    margin: 0;
    color: var(--nr-heading);
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  #nr-carousel-{{ block.id }} .nr-carousel-track-shell {
    position: relative;
  }

  #nr-carousel-{{ block.id }} .nr-car-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 4px 2px 18px;
  }

  #nr-carousel-{{ block.id }} .nr-car-track::-webkit-scrollbar {
    display: none;
  }

  #nr-carousel-{{ block.id }} .nr-car-card {
    width: var(--nr-card-width);
    flex: 0 0 var(--nr-card-width);
    min-height: var(--nr-card-min-height);
    scroll-snap-align: start;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px;
    background: var(--nr-card-bg);
    border: 1px solid var(--nr-card-border);
    border-radius: var(--nr-card-radius);
    color: var(--nr-text);
  }

  #nr-carousel-{{ block.id }}[data-card-shadow="soft"] .nr-car-card {
    box-shadow: 0 10px 28px rgba(17, 24, 39, 0.08);
  }

  #nr-carousel-{{ block.id }}[data-card-shadow="medium"] .nr-car-card {
    box-shadow: 0 16px 44px rgba(17, 24, 39, 0.12);
  }

  #nr-carousel-{{ block.id }} .nr-car-stars {
    color: var(--nr-star);
    font-size: 18px;
    line-height: 1;
    letter-spacing: 1px;
    margin-bottom: 18px;
  }

  #nr-carousel-{{ block.id }} .nr-car-headline {
    margin: 0 0 10px;
    color: var(--nr-text);
    font-size: 17px;
    line-height: 1.25;
    font-weight: 800;
  }

  #nr-carousel-{{ block.id }} .nr-car-body {
    margin: 0 0 24px;
    color: var(--nr-muted);
    font-size: 14px;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: {{ block.settings.body_line_clamp }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #nr-carousel-{{ block.id }} .nr-car-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  #nr-carousel-{{ block.id }} .nr-car-author {
    color: var(--nr-text);
    font-size: 13px;
    line-height: 1.3;
    font-weight: 800;
  }

  #nr-carousel-{{ block.id }} .nr-verified {
    color: #059669;
    font-weight: 800;
  }

  #nr-carousel-{{ block.id }} .nr-prod-link {
    display: {% if block.settings.show_product_button %}inline-flex{% else %}none{% endif %};
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 8px 12px;
    border-radius: var(--nr-product-btn-radius);
    background: var(--nr-product-btn-bg);
    color: var(--nr-product-btn-color);
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  #nr-carousel-{{ block.id }} .nr-prod-link:hover {
    transform: translateY(-1px);
  }

  #nr-carousel-{{ block.id }} .nr-car-nav {
    width: var(--nr-arrow-size);
    height: var(--nr-arrow-size);
    border-radius: var(--nr-arrow-radius);
    border: 1px solid var(--nr-arrow-border);
    background: var(--nr-arrow-bg);
    color: var(--nr-arrow-color);
    opacity: var(--nr-arrow-opacity);
    box-shadow: 0 8px 22px rgba(17, 24, 39, 0.12);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
  }

  #nr-carousel-{{ block.id }} .nr-car-nav:hover {
    opacity: 1;
    transform: translateY(-1px);
    box-shadow: 0 12px 28px rgba(17, 24, 39, 0.16);
  }

  #nr-carousel-{{ block.id }} .nr-car-nav svg {
    width: 45%;
    height: 45%;
    display: block;
  }

  #nr-carousel-{{ block.id }} .nr-carousel-top-controls {
    display: none;
    gap: 10px;
    margin-bottom: 14px;
    pointer-events: auto;
  }

  #nr-carousel-{{ block.id }} .nr-car-nav-split {
    display: none;
    position: absolute;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="split_middle"] .nr-car-nav-split,
  #nr-carousel-{{ block.id }}[data-arrow-layout="split_top"] .nr-car-nav-split,
  #nr-carousel-{{ block.id }}[data-arrow-layout="split_bottom"] .nr-car-nav-split {
    display: inline-flex;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="split_middle"] .nr-car-nav-split {
    top: 50%;
    transform: translateY(-50%);
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="split_middle"] .nr-car-nav-split:hover {
    transform: translateY(-50%) scale(1.04);
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="split_top"] .nr-car-nav-split {
    top: 16px;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="split_bottom"] .nr-car-nav-split {
    bottom: 28px;
  }

  #nr-carousel-{{ block.id }} .nr-car-prev.nr-car-nav-split {
    left: -{{ block.settings.arrow_offset }}px;
  }

  #nr-carousel-{{ block.id }} .nr-car-next.nr-car-nav-split {
    right: -{{ block.settings.arrow_offset }}px;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="top_right"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="top_left"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_right"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_left"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="center_top"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="center_bottom"] .nr-carousel-top-controls {
    display: flex;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="top_right"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_right"] .nr-carousel-top-controls {
    justify-content: flex-end;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="top_left"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_left"] .nr-carousel-top-controls {
    justify-content: flex-start;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="center_top"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="center_bottom"] .nr-carousel-top-controls {
    justify-content: center;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_right"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_left"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="center_bottom"] .nr-carousel-top-controls {
    order: 3;
    margin: 14px 0 0;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_right"] .nr-carousel-inner,
  #nr-carousel-{{ block.id }}[data-arrow-layout="bottom_left"] .nr-carousel-inner,
  #nr-carousel-{{ block.id }}[data-arrow-layout="center_bottom"] .nr-carousel-inner {
    display: flex;
    flex-direction: column;
  }

  #nr-carousel-{{ block.id }}[data-arrow-layout="hidden"] .nr-carousel-top-controls,
  #nr-carousel-{{ block.id }}[data-arrow-layout="hidden"] .nr-car-nav-split {
    display: none !important;
  }

  @media (max-width: 768px) {
    #nr-carousel-{{ block.id }} {
      padding-left: {{ block.settings.mobile_padding_x }}px;
      padding-right: {{ block.settings.mobile_padding_x }}px;
    }

    #nr-carousel-{{ block.id }} .nr-car-card {
      width: min({{ block.settings.mobile_card_width }}px, 86vw);
      flex-basis: min({{ block.settings.mobile_card_width }}px, 86vw);
    }

    {% unless block.settings.show_arrows_mobile %}
      #nr-carousel-{{ block.id }} .nr-carousel-top-controls,
      #nr-carousel-{{ block.id }} .nr-car-nav-split {
        display: none !important;
      }
    {% endunless %}
  }
</style>

<script>
(function() {
  const SHOP_DOMAIN = "{{ shop.domain }}";
  const API = "https://nectar-reviews-api.onrender.com/api";
  const BLOCK_ID = "{{ block.id }}";
  const isEditor = {{ request.design_mode | default: false | json }};
  const custEmail = "{{ customer.email | default: '' }}".toLowerCase();

  const root = document.getElementById(`nr-carousel-${BLOCK_ID}`);
  const track = document.getElementById(`nr-carousel-track-${BLOCK_ID}`);
  if (!root || !track) return;

  const limit = {{ block.settings.review_limit | default: 10 }};
  const enableAutoplay = {{ block.settings.autoplay | default: true | json }};
  const autoplayDelay = {{ block.settings.autoplay_speed | default: 4 }} * 1000;
  const pauseOnHover = {{ block.settings.pause_on_hover | default: true | json }};
  const scrollAmountSetting = {{ block.settings.scroll_amount | default: 1 }};

  let autoplayTimer = null;
  let isPaused = false;

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function stars(rating) {
    const n = Math.max(0, Math.min(5, parseInt(rating, 10) || 0));
    return '★'.repeat(n) + '☆'.repeat(5 - n);
  }

  function arrowSvg(direction) {
    const icon = root.dataset.arrowIcon || 'arrow';
    const isNext = direction === 'next';

    if (icon === 'chevron') {
      return isNext
        ? '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }

    if (icon === 'caret') {
      return isNext
        ? '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 6.5L16 12l-6.5 5.5z"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.5 6.5L8 12l6.5 5.5z"/></svg>';
    }

    if (icon === 'plus') {
      return isNext
        ? '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }

    return isNext
      ? '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  }

  function setArrowIcons() {
    root.querySelectorAll('.nr-car-prev').forEach(btn => { btn.innerHTML = arrowSvg('prev'); });
    root.querySelectorAll('.nr-car-next').forEach(btn => { btn.innerHTML = arrowSvg('next'); });
  }

  function getScrollAmount() {
    const firstCard = track.querySelector('.nr-car-card');
    if (!firstCard) return 340;

    const gap = parseFloat(getComputedStyle(track).gap || '20') || 20;
    const cardWidth = firstCard.getBoundingClientRect().width;
    return (cardWidth + gap) * scrollAmountSetting;
  }

  function scrollCarousel(direction) {
    const amount = getScrollAmount();
    const left = direction === 'next' ? amount : -amount;
    track.scrollBy({ left, behavior: 'smooth' });
  }

  function startAutoplay() {
    if (!enableAutoplay || autoplayTimer) return;

    autoplayTimer = setInterval(() => {
      if (isPaused) return;

      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 12) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        scrollCarousel('next');
      }
    }, autoplayDelay);
  }

  function bindEvents() {
    root.querySelectorAll('.nr-car-nav').forEach(button => {
      button.addEventListener('click', () => scrollCarousel(button.dataset.dir));
    });

    if (pauseOnHover) {
      root.addEventListener('mouseenter', () => { isPaused = true; });
      root.addEventListener('mouseleave', () => { isPaused = false; });
    }
  }

  async function resolveProductUrl(itemId) {
    if (!itemId) return '#';

    try {
      const response = await fetch(`https://${SHOP_DOMAIN}/search/suggest.json?q=id:${encodeURIComponent(itemId)}&resources[type]=product&resources[limit]=1`);
      const data = await response.json();
      const product = data && data.resources && data.resources.results && data.resources.results.products && data.resources.results.products[0];
      return product && product.url ? product.url.split('?')[0] : '#';
    } catch (error) {
      return '#';
    }
  }

  async function init() {
    setArrowIcons();
    bindEvents();

    try {
      const configRes = await fetch(`${API}/widget/config?shopDomain=${encodeURIComponent(SHOP_DOMAIN)}&t=${Date.now()}`);
      if (!configRes.ok) return;
      const configData = await configRes.json();

      if (configData.betaMode && configData.betaMode.enabled) {
        if (!isEditor && custEmail !== String(configData.betaMode.email || '').toLowerCase()) return;
      }

      const reviewsRes = await fetch(`${API}/global-reviews?shopDomain=${encodeURIComponent(SHOP_DOMAIN)}&t=${Date.now()}`);
      if (!reviewsRes.ok) return;
      const reviews = await reviewsRes.json();
      if (!Array.isArray(reviews) || reviews.length === 0) return;

      const sliced = reviews.slice(0, limit);
      const enriched = await Promise.all(sliced.map(async review => ({
        ...review,
        productUrl: await resolveProductUrl(review.itemId)
      })));

      track.innerHTML = enriched.map(review => {
        const headline = review.headline ? `<h3 class="nr-car-headline">${escapeHtml(review.headline)}</h3>` : '';
        const productLink = review.productUrl && review.productUrl !== '#'
          ? `<a href="${escapeHtml(review.productUrl)}" class="nr-prod-link">{{ block.settings.product_button_label }}</a>`
          : '';

        return `
          <article class="nr-car-card">
            <div class="nr-car-stars" aria-label="${escapeHtml(review.rating)} out of 5 stars">${stars(review.rating)}</div>
            ${headline}
            <p class="nr-car-body">${escapeHtml(review.comment)}</p>
            <div class="nr-car-footer">
              <div class="nr-car-author">${escapeHtml(review.userId || 'Verified customer')} <span class="nr-verified">✓</span></div>
              ${productLink}
            </div>
          </article>
        `;
      }).join('');

      root.style.display = 'block';
      startAutoplay();
    } catch (error) {
      console.error('Nectar review carousel error:', error);
    }
  }

  init();
})();
</script>

{% schema %}
{
  "name": "Global Review Carousel",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by our customers"
    },
    {
      "type": "select",
      "id": "width_mode",
      "label": "Widget width",
      "default": "fixed",
      "options": [
        { "value": "fixed", "label": "Fixed width" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Fixed max width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "section_padding_x",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Side padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_y",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top/bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_x",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile side padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "review_limit",
      "min": 3,
      "max": 20,
      "step": 1,
      "label": "Maximum reviews to show",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 240,
      "max": 460,
      "step": 10,
      "unit": "px",
      "label": "Card width",
      "default": 340
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 240,
      "max": 380,
      "step": 10,
      "unit": "px",
      "label": "Mobile card width",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_min_height",
      "min": 180,
      "max": 420,
      "step": 10,
      "unit": "px",
      "label": "Minimum card height",
      "default": 250
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 16
    },
    {
      "type": "select",
      "id": "card_shadow",
      "label": "Card shadow",
      "default": "soft",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "soft", "label": "Soft" },
        { "value": "medium", "label": "Medium" }
      ]
    },
    {
      "type": "range",
      "id": "body_line_clamp",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Review text lines",
      "default": 4
    },
    {
      "type": "header",
      "content": "Arrows"
    },
    {
      "type": "select",
      "id": "arrow_layout",
      "label": "Arrow location",
      "default": "split_middle",
      "options": [
        { "value": "split_middle", "label": "Split - middle sides" },
        { "value": "split_top", "label": "Split - top sides" },
        { "value": "split_bottom", "label": "Split - bottom sides" },
        { "value": "top_right", "label": "Together - top right" },
        { "value": "top_left", "label": "Together - top left" },
        { "value": "center_top", "label": "Together - top center" },
        { "value": "bottom_right", "label": "Together - bottom right" },
        { "value": "bottom_left", "label": "Together - bottom left" },
